pipeline {
  agent any

  environment {
    AWS_REGION   = 'us-east-1'
    ECR_REPO     = credentials('ecr-repo-url')       // e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com/devops-eks-cicd-dev-app
    IMAGE_TAG    = "${env.BUILD_NUMBER}"
    CLUSTER_NAME = 'devops-eks-cicd-dev-eks'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install & Unit Test') {
      steps {
        dir('app') {
          sh 'npm ci --cache .npm-cache'
          sh 'npm test'
        }
      }
    }

    stage('Build & Push Docker Image') {
      steps {
        dir('app') {
          // Single quotes below = Groovy does NOT interpolate $ECR_REPO/$IMAGE_TAG/$AWS_REGION
          // here; the shell expands them instead. This is what silences the
          // "secret passed via Groovy String interpolation" warning.
          sh '''
            aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REPO"
            docker buildx build --platform linux/amd64 \
              -t "$ECR_REPO:$IMAGE_TAG" \
              -t "$ECR_REPO:latest" \
              --push .
          '''
        }
      }
    }

    stage('Deploy to EKS') {
      steps {
        sh '''
          aws eks update-kubeconfig --region "$AWS_REGION" --name "$CLUSTER_NAME"
          kubectl apply -f k8s/namespace.yaml
          sed -e "s|IMAGE_PLACEHOLDER|$ECR_REPO:$IMAGE_TAG|" k8s/deployment.yaml | kubectl apply -f -
          kubectl apply -f k8s/service.yaml
          kubectl apply -f k8s/hpa.yaml
          kubectl apply -f k8s/ingress.yaml
        '''
      }
    }

    stage('Verify Rollout') {
      steps {
        sh 'kubectl rollout status deployment/devops-demo-api -n devops-demo --timeout=120s'
      }
    }
  }

  post {
    success {
      echo "Deployed build ${IMAGE_TAG} to ${CLUSTER_NAME}"
    }
    failure {
      echo "Pipeline failed — check stage logs above. Wire a Slack/email notifier here for real alerts."
    }
    always {
      sh 'docker image prune -f' // 💰 don't let build images pile up on the Jenkins host disk
    }
  }
}